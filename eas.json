{
  "cli": {
    "version": ">= 18.0.0"
  },
  "build": {
    "ios-dev": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "credentialsSource": "remote"
      }
    },
    "android-dev": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}

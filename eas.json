{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "ios-dev": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    }
  }
}
